{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "reasonCode", "rationaleSummary"],
  "properties": {
    "outcome": { "enum": ["PROPOSAL", "NO_PROPOSAL", "NEEDS_MORE_CONTEXT", "BOUNDARY_REVIEW"] },
    "change": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "currentFocus"], "properties": { "type": { "const": "SET_CURRENT_FOCUS" }, "currentFocus": { "type": ["string", "null"], "maxLength": 200 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "desiredOutcome", "completionChecks"], "properties": { "type": { "const": "UPDATE_WORK_INTENT" }, "desiredOutcome": { "type": ["string", "null"], "maxLength": 500 }, "completionChecks": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } } } }
      ]
    },
    "candidate": { "enum": ["SPLIT", "MERGE", "KIND_CHANGE", "PROJECT_OWNERSHIP", "PARKED", "CLOSURE", "HISTORY_MOVE"] },
    "recommendation": { "type": "string" },
    "question": { "type": "string" },
    "reasonCode": { "type": "string" },
    "rationaleSummary": { "type": "string" }
  }
}
