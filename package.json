{
  "name": "task-copilot-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check:boundaries": "node scripts/check-mvp-boundaries.mjs",
    "check:rules": "node scripts/check-rule-coverage.mjs",
    "acceptance:rehearsal": "tsx scripts/acceptance-rehearsal.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:boundaries && npm run check:rules && npm run acceptance:rehearsal"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
